# Copia este archivo como supabase/functions/.env (no se sube a git).
# Basta con UNA de las dos claves:
#
# Groq (plan gratuito): https://console.groq.com → API Keys
GROQ_API_KEY=
#
# Anthropic Claude (de pago, más preciso): https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
#
# Si hay las dos, se usa Claude. Para forzar una: AI_PROVIDER=groq o AI_PROVIDER=anthropic
